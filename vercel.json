{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build/online.py && python3 scripts/build/seo.py",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/book/index.html", "destination": "/chapter-Preface.html" },
    { "source": "/book/chapter-:slug", "destination": "/chapter-:slug" }
  ],
  "headers": [
    {
      "source": "/(js|styles)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
