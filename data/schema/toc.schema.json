{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "toc.json —— 六十三卷目录",
  "type": "object",
  "properties": {
    "meta": {"type": "object"},
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "volume": {"type": "integer"},
          "name": {"type": "string", "description": "简体卷名"},
          "name_original": {"type": "string", "description": "原繁体卷名"},
          "chars": {"type": "integer"},
          "persons": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
