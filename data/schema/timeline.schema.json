{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "timeline.json —— 生卒与活跃期",
  "type": "object",
  "properties": {
    "meta": {"type": "object"},
    "emperors": {"type": "array", "items": {
      "type": "object",
      "properties": {"n": {"type": "integer"}, "era": {"type": "string"},
                     "name": {"type": "string"},
                     "start": {"type": "integer"}, "end": {"type": "integer"}}}},
    "period": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "birth": {"type": ["integer", "null"]},
          "death": {"type": ["integer", "null"]},
          "active": {"type": ["array", "null"], "items": {"type": "integer"}},
          "method": {
            "type": "string",
            "description": "史载 / 书载·进士 / 推算（依师承代次） / 不详。推算值只能用于排布，不可当史实引用"
          }
        }
      }
    }
  }
}
