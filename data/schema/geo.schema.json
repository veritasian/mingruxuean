{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "geo.json —— 籍贯",
  "type": "object",
  "properties": {
    "meta": {"type": "object"},
    "places": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "prov": {"type": "string"},
          "city": {"type": "string"},
          "note": {"type": "string", "description": "今地名比定"},
          "raw":  {"type": "string", "description": "原书籍贯原文"}
        }
      }
    },
    "birth_patterns": {"type": "object", "description": "原文籍贯表述 → 今地名的对照表"}
  }
}
